{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests", "-m", "not slow"],
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.egg-info": true
  },
  "search.exclude": {
    ".venv": true,
    "data/standard_ml_sets": true
  }
}
